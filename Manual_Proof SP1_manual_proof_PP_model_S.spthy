                                    h3(x.106, x.107, blind(h1(t.90), r.77), x.110, x.111, z.99))))
         z.4   = z.99
         z.5   = z.100
         z.6   = calcB(multiply(pow(blind(h1(t1.91), r1.78),
                                    mod(minus(x.129,
                                              multiply(h3(X.72, x.113, x.114, x.115, z.100, x.117),
                                                       x.105)),
                                        x.130)),
                                pow(sign(sign(blind(h1(x.133), r1.78), x.134), x.135),
                                    h3(X.72, x.113, x.114, x.115, z.100, x.117))))
         z.7   = z.102
         z.8   = calcB(multiply(pow(blind(h1(t2.92), r2.79),
                                    mod(minus(x.131,
                                              multiply(h3(X.72, x.118, x.119, x.120, z.102, x.122),
                                                       x.105)),
                                        x.132)),
                                pow(sign(sign(blind(h1(x.136), r2.79), x.137), x.138),
                                    h3(X.72, x.118, x.119, x.120, z.102, x.122))))
    
    512. X     = X.73
         Y     = pow(X.73, x.106)
         c     = h3(X.73, x.107, x.108, x.109, z.99, x.111)
         c1    = h3(X.73, x.112, x.113, x.114, z.101, x.116)
         c2    = h3(X.73, x.117, x.118, x.119, z.103, x.121)
         r     = r.78
         r1    = r1.79
         r2    = r2.80
         s     = mod(minus(x.126,
                           multiply(h3(X.73, x.107, x.108, x.109, z.99, x.111), x.106)),
                     x.127)
         s1    = mod(minus(x.128,
                           multiply(h3(X.73, x.112, x.113, x.114, z.101, x.116), x.106)),
                     x.129)
         s2    = mod(minus(x.130,
                           multiply(h3(X.73, x.117, x.118, x.119, z.103, x.121), x.106)),
                     x.131)
         signedBlTok
               = sign(sign(blind(h1(x.132), r.78), x.133), x.134)
         signedBlTok1
               = sign(sign(blind(h1(x.135), r1.79), x.136), x.137)
         signedBlTok2
               = sign(sign(blind(h1(x.138), r2.80), x.139), x.140)
         t     = t.91
         t1    = t1.92
         t2    = t2.93
         z     = sign(sign(h1(x.132), x.133), x.134)
         z.1   = sign(sign(h1(x.135), x.136), x.137)
         z.2   = sign(sign(h1(x.138), x.139), x.140)
         z.3   = z.99
         z.4   = calcB(multiply(pow(blind(h1(t.91), r.78),
                                    mod(minus(x.126,
                                              multiply(h3(X.73, x.107, x.108, x.109, z.99, x.111),
                                                       x.106)),
                                        x.127)),
                                pow(sign(sign(blind(h1(x.132), r.78), x.133), x.134),
                                    h3(X.73, x.107, x.108, x.109, z.99, x.111))))
         z.5   = z.101
         z.6   = calcB(multiply(pow(blind(h1(t1.92), r1.79),
                                    mod(minus(x.128,
                                              multiply(h3(X.73, x.112, x.113, x.114, z.101, x.116),
                                                       x.106)),
                                        x.129)),
                                pow(sign(sign(blind(h1(x.135), r1.79), x.136), x.137),
                                    h3(X.73, x.112, x.113, x.114, z.101, x.116))))
         z.7   = z.103
         z.8   = calcB(multiply(pow(blind(h1(t2.93), r2.80),
                                    mod(minus(x.130,
                                              multiply(h3(X.73, x.117, x.118, x.119, z.103, x.121),
                                                       x.106)),
                                        x.131)),
                                pow(sign(sign(blind(h1(x.138), r2.80), x.139), x.140),
                                    h3(X.73, x.117, x.118, x.119, z.103, x.121))))
    // loop breaker: [0]
  */

rule (modulo E) Usr_send_request:
   [
   Store( ~chId_srv_usr, $Usr, $Srv, <r, t, unblinded, srvSignedToken>
   ),
   Fr( ~request )
   ]
  --[ UsrSendRequest( $Usr, $Srv, ~request, t ) ]->
   [
   Out_S( ~chId_srv_usr, $Usr, $Srv, <'6', $Usr, URL(~request)> ),
   State_Usr_request_token( ~chId_srv_usr, $Usr, $Srv, t, unblinded,
                            ~request, unblind(srvSignedToken, r)
   )
   ]

  /*
  rule (modulo AC) Usr_send_request:
     [
     Store( ~chId_srv_usr, $Usr, $Srv, <r, t, unblinded, srvSignedToken>
     ),
     Fr( ~request )
     ]
    --[ UsrSendRequest( $Usr, $Srv, ~request, t ) ]->
     [
     Out_S( ~chId_srv_usr, $Usr, $Srv, <'6', $Usr, URL(~request)> ),
     State_Usr_request_token( ~chId_srv_usr, $Usr, $Srv, t, unblinded,
                              ~request, z
     )
     ]
    variants (modulo AC)
    1. r     = r.12
       srvSignedToken
             = srvSignedToken.13
       z     = unblind(srvSignedToken.13, r.12)
    
    2. r     = r.14
       srvSignedToken
             = sign(blind(h1(x.21), r.14), x.22)
       z     = sign(h1(x.21), x.22)
    
    3. r     = r.15
       srvSignedToken
             = sign(sign(blind(h1(x.22), r.15), x.23), x.24)
       z     = sign(sign(h1(x.22), x.23), x.24)
  */

rule (modulo E) Srv_send_new_challenge[derivchecks]:
   [
   In_S( ~chId_srv_usr, $Usr, $Srv, <'6', $Usr, URL(request)> ),
   !State_Srv_send_proof( srv_secr_key, ~chId_srv_ti, ~chId_srv_usr,
                          $Srv, $Usr, url, Y
   ),
   Fr( ~newChlg )
   ]
  --[ SrvPresentNewChallenge( $Srv, $Usr, ~newChlg ) ]->
   [
   Out_S( ~chId_srv_usr, $Srv, $Usr,
          <'7', $Srv, Challenge(~newChlg), Y>
   ),
   State_Srv_challenge_new( srv_secr_key, ~chId_srv_ti, ~chId_srv_usr,
                            $Srv, $Usr, ~newChlg, url, request
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Usr_send_stored_token[derivchecks]:
   [
   In_S( ~chId_srv_usr, $Srv, $Usr, <'7', $Srv, Challenge(newChlg), Y>
   ),
   State_Usr_request_token( ~chId_srv_usr, $Usr, $Srv, t, unblinded,
                            request, unblindedSrvSigned
   )
   ]
  --[
  UsrSendStoredToken( $Usr, $Srv, t, unblinded ),
  Usr_token_send( ~chId_srv_usr, $Usr, $Srv,
                  <'8', $Usr, Challenge(newChlg), URL(request), Token(t), 
                   SMAC(MAC(h2(t, unblinded), CalcR($Usr, $Ti, request))), 
                   MAC(h2(t, unblindedSrvSigned), CalcR($Usr, $Srv, request))>
  )
  ]->
   [
   Out_S( ~chId_srv_usr, $Usr, $Srv,
          <'8', $Usr, Challenge(newChlg), URL(request), Token(t), 
           SMAC(MAC(h2(t, unblinded), CalcR($Usr, $Ti, request))), 
           MAC(h2(t, unblindedSrvSigned), CalcR($Usr, $Srv, request))>
   ),
   State_Usr_send_stored_token( ~chId_srv_usr, $Usr, $Srv, request, t
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Srv_forward_stored_token[derivchecks]:
   [
   In_S( ~chId_srv_usr, $Usr, $Srv,
         <'8', $Usr, Challenge(newChlg), URL(request), Token(t), SMAC(s), 
          hash_srvSignedToken>
   ),
   State_Srv_challenge_new( srv_secr_key, ~chId_srv_ti, ~chId_srv_usr,
                            $Srv, $Usr, newChlg, url, request
   )
   ]
  --[
  SrvForwardStoredToken( $Srv, $Ti, t ),
  Usr_token_rcv( ~chId_srv_usr, $Usr, $Srv,
                 <'8', $Usr, Challenge(newChlg), URL(request), Token(t), SMAC(s), 
                  hash_srvSignedToken>
  )
  ]->
   [
   Out_S( ~chId_srv_ti, $Srv, $Ti,
          <'8', $Usr, URL(request), Token(t), SMAC(s)>
   ),
   State_Srv_forward_stored_token( hash_srvSignedToken, t,
                                   srv_secr_key, ~chId_srv_ti, ~chId_srv_usr, $Srv, $Ti, request
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Ti_verify_stored_token[derivchecks]:
   [
   In_S( ~chId_srv_ti, $Srv, $Ti,
         <'8', $Usr, URL(request), Token(t), SMAC(s)>
   ),
   !State_Ti_signedBlTok( ~chId_srv_ti, $Ti, $Srv, secr_key,
                          signedBlTok, signedBlTok1, signedBlTok2
   )
   ]
  --[
  Eq( CheckTokenSpent($Ti, t), false ),
  Eq( s, MAC(h2(t, sign(h1(t), secr_key)), CalcR($Usr, $Ti, request))
  ),
  TiVerifySignedToken( $Ti, t, secr_key ),
  Ti_verify_redeeming_sent( ~chId_srv_ti, $Ti, $Srv,
                            <'9', URL(request), true, SignedToken(sign(h1(t), secr_key))>
  )
  ]->
   [
   Out_S( ~chId_srv_ti, $Ti, $Srv,
          <'9', URL(request), true, SignedToken(sign(h1(t), secr_key))>
   ),
   TokenSpent( $Ti, $Usr, t )
   ]

  // loop breaker: [0]
  /*
  rule (modulo AC) Ti_verify_stored_token[derivchecks]:
     [
     In_S( ~chId_srv_ti, $Srv, $Ti,
           <'8', $Usr, URL(request), Token(t), SMAC(s)>
     ),
     !State_Ti_signedBlTok( ~chId_srv_ti, $Ti, $Srv, secr_key,
                            signedBlTok, signedBlTok1, signedBlTok2
     )
     ]
    --[
    Eq( false, false ),
    Eq( s, MAC(h2(t, sign(h1(t), secr_key)), CalcR($Usr, $Ti, request))
    ),
    TiVerifySignedToken( $Ti, t, secr_key ),
    Ti_verify_redeeming_sent( ~chId_srv_ti, $Ti, $Srv,
                              <'9', URL(request), true, SignedToken(sign(h1(t), secr_key))>
    )
    ]->
     [
     Out_S( ~chId_srv_ti, $Ti, $Srv,
            <'9', URL(request), true, SignedToken(sign(h1(t), secr_key))>
     ),
     TokenSpent( $Ti, $Usr, t )
     ]
    // loop breaker: [0]
  */

rule (modulo E) Srv_send_new_res[derivchecks]:
   [
   In_S( ~chId_srv_ti, $Ti, $Srv,
         <'9', URL(request), verified, SignedToken(signedToken)>
   ),
   Fr( ~newRes ),
   State_Srv_forward_stored_token( hash_srvSignedToken, t,
                                   srv_secr_key, ~chId_srv_ti, ~chId_srv_usr, $Srv, $Ti, request
   )
   ]
  --[
  Eq( verified, true ),
  Eq( hash_srvSignedToken,
      MAC(h2(t, sign(signedToken, srv_secr_key)),
          CalcR($Usr, $Srv, request))
  ),
  SrvSendNewResource( $Srv, $Usr, ~newRes, t ),
  Ti_verify_redeeming_rcv( ~chId_srv_ti, $Ti, $Srv,
                           <'9', URL(request), verified, SignedToken(signedToken)>
  )
  ]->
   [
   Out_S( ~chId_srv_usr, $Srv, $Usr,
          <'10', URL(request), WebResources(~newRes)>
   )
   ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) Usr_receive_res[derivchecks]:
   [
   In_S( ~chId_srv_usr, $Srv, $Usr,
         <'10', URL(request), WebResources(newRes)>
   ),
   State_Usr_send_stored_token( ~chId_srv_usr, $Usr, $Srv, request, t
   )
   ]
  --[ UsrReceivedNewResource( $Usr, $Srv, request, t, newRes ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma correctness:
  exists-trace
  "∃ user server url Y srv_key secr_key tokenIssuer challenge
     solution blindedToken blindedToken1 blindedToken2 c s c1 s1 c2 s2
     signedBlTok signedBlTok1 signedBlTok2 t1 t2 t3 unblinded unblinded1
     unblinded2 request1 newchallenge newRes1 request2 newRes2 request3
     newRes3 #t00 #t01 #t02 #t03 #t04 #t05 #t06 #t07 #t08 #t09 #t10 #t11
     #t12 #t13 #t14 #t15 #t16 #t17 #t18 #t19 #t20.
    ((((((((((((((((((((((((((((((((((((((((Setup_Ti( tokenIssuer, Y,
                                                      secr_key
                                            ) @ #t00) ∧
                                           (Setup_Srv( server, tokenIssuer, Y, srv_key ) @ #t01)) ∧
                                          (Setup_Usr( user, server, Y ) @ #t02)) ∧
                                         (RequestContent( user, server, url ) @ #t03)) ∧
                                        (SrvPresentChallenge( server, user, tokenIssuer, challenge,
                                                              url
                                         ) @ #t04)) ∧
                                       (UsrSendSolution( user, server, tokenIssuer, solution,
                                                         blindedToken, blindedToken1, blindedToken2,
                                                         url
                                        ) @ #t05)) ∧
                                      (SrvForwardSolution( user, server, tokenIssuer, solution, url
                                       ) @ #t06)) ∧
                                     (TiSignBlindedTokens( tokenIssuer, solution, secr_key,
                                                           signedBlTok, signedBlTok1, signedBlTok2
                                      ) @ #t07)) ∧
                                    (SrvForwardSignedBlindedTokens( server, user, c, s, c1, s1, c2,
                                                                    s2
                                     ) @ #t08)) ∧
                                   (UsrStoreUnblindedTokens( user, server, t1, t2, t3, unblinded,
                                                             unblinded1, unblinded2, Y
                                    ) @ #t09)) ∧
                                  (UsrSendRequest( user, server, request1, t1 ) @ #t10)) ∧
                                 (SrvPresentNewChallenge( server, user, newchallenge ) @ #t11)) ∧
                                (UsrSendStoredToken( user, server, t1, unblinded ) @ #t12)) ∧
                               (SrvForwardStoredToken( server, tokenIssuer, t1 ) @ #t13)) ∧
                              (TiVerifySignedToken( tokenIssuer, t1, secr_key ) @ #t14)) ∧
                             (SrvSendNewResource( server, user, newRes1, t1 ) @ #t15)) ∧
                            (UsrReceivedNewResource( user, server, request1, t1, newRes1
                             ) @ #t16)) ∧
                           (UsrSendRequest( user, server, request2, t2 ) @ #t17)) ∧
                          (UsrReceivedNewResource( user, server, request2, t2, newRes2
                           ) @ #t18)) ∧
                         (UsrSendRequest( user, server, request3, t3 ) @ #t19)) ∧
                        (UsrReceivedNewResource( user, server, request3, t3, newRes3
                         ) @ #t20)) ∧
                       (#t00 < #t01)) ∧
                      (#t01 < #t02)) ∧
                     (#t02 < #t03)) ∧
                    (#t03 < #t04)) ∧
                   (#t04 < #t05)) ∧
                  (#t05 < #t06)) ∧
                 (#t06 < #t07)) ∧
                (#t07 < #t08)) ∧
               (#t08 < #t09)) ∧
              (#t09 < #t10)) ∧
             (#t10 < #t11)) ∧
            (#t11 < #t12)) ∧
           (#t12 < #t13)) ∧
          (#t13 < #t14)) ∧
         (#t14 < #t15)) ∧
        (#t15 < #t16)) ∧
       (¬(request1 = request2))) ∧
      (¬(request1 = request3))) ∧
     (¬(request2 = request3))) ∧
    (¬(∃ x #c.1. Rev( x, 'secureChannel' ) @ #c.1))"
/*
guarded formula characterizing all satisfying traces:
"∃ user server url Y srv_key secr_key tokenIssuer challenge
   solution blindedToken blindedToken1 blindedToken2 c s c1 s1 c2 s2
   signedBlTok signedBlTok1 signedBlTok2 t1 t2 t3 unblinded unblinded1
   unblinded2 request1 newchallenge newRes1 request2 newRes2 request3
   newRes3 #t00 #t01 #t02 #t03 #t04 #t05 #t06 #t07 #t08 #t09 #t10 #t11
   #t12 #t13 #t14 #t15 #t16 #t17 #t18 #t19 #t20.
  (Setup_Ti( tokenIssuer, Y, secr_key ) @ #t00) ∧
  (Setup_Srv( server, tokenIssuer, Y, srv_key ) @ #t01) ∧
  (Setup_Usr( user, server, Y ) @ #t02) ∧
  (RequestContent( user, server, url ) @ #t03) ∧
  (SrvPresentChallenge( server, user, tokenIssuer, challenge, url
   ) @ #t04) ∧
  (UsrSendSolution( user, server, tokenIssuer, solution,
                    blindedToken, blindedToken1, blindedToken2, url
   ) @ #t05) ∧
  (SrvForwardSolution( user, server, tokenIssuer, solution, url
   ) @ #t06) ∧
  (TiSignBlindedTokens( tokenIssuer, solution, secr_key, signedBlTok,
                        signedBlTok1, signedBlTok2
   ) @ #t07) ∧
  (SrvForwardSignedBlindedTokens( server, user, c, s, c1, s1, c2, s2
   ) @ #t08) ∧
  (UsrStoreUnblindedTokens( user, server, t1, t2, t3, unblinded,
                            unblinded1, unblinded2, Y
   ) @ #t09) ∧
  (UsrSendRequest( user, server, request1, t1 ) @ #t10) ∧
  (SrvPresentNewChallenge( server, user, newchallenge ) @ #t11) ∧
  (UsrSendStoredToken( user, server, t1, unblinded ) @ #t12) ∧
  (SrvForwardStoredToken( server, tokenIssuer, t1 ) @ #t13) ∧
  (TiVerifySignedToken( tokenIssuer, t1, secr_key ) @ #t14) ∧
  (SrvSendNewResource( server, user, newRes1, t1 ) @ #t15) ∧
  (UsrReceivedNewResource( user, server, request1, t1, newRes1
   ) @ #t16) ∧
  (UsrSendRequest( user, server, request2, t2 ) @ #t17) ∧
  (UsrReceivedNewResource( user, server, request2, t2, newRes2
   ) @ #t18) ∧
  (UsrSendRequest( user, server, request3, t3 ) @ #t19) ∧
  (UsrReceivedNewResource( user, server, request3, t3, newRes3
   ) @ #t20)
 ∧
  (#t00 < #t01) ∧
  (#t01 < #t02) ∧
  (#t02 < #t03) ∧
  (#t03 < #t04) ∧
  (#t04 < #t05) ∧
  (#t05 < #t06) ∧
  (#t06 < #t07) ∧
  (#t07 < #t08) ∧
  (#t08 < #t09) ∧
  (#t09 < #t10) ∧
  (#t10 < #t11) ∧
  (#t11 < #t12) ∧
  (#t12 < #t13) ∧
  (#t13 < #t14) ∧
  (#t14 < #t15) ∧
  (#t15 < #t16) ∧
  (¬(request1 = request2)) ∧
  (¬(request1 = request3)) ∧
  (¬(request2 = request3)) ∧
  (∀ x #c.1. (Rev( x, 'secureChannel' ) @ #c.1) ⇒ ⊥)"
*/
by sorry

lemma single_signing_key:
  all-traces
  "∀ user server t unbl commitment solution bt tokenIssuer Y secr_key
     #t01 #t02 #t03.
    (((((Setup_Ti( tokenIssuer, Y, secr_key ) @ #t01) ∧
        (UsrCreateToken( user, server, tokenIssuer, solution, bt, t
         ) @ #t02)) ∧
       (UsrVerifyAndStoreToken( user, server, t, unbl, commitment
        ) @ #t03)) ∧
      (#t01 < #t02)) ∧
     (#t02 < #t03)) ⇒
    (∃ #i.
      ((TiSignsToken( tokenIssuer, t, secr_key ) @ #i) ∧ (#t02 < #i)) ∧
      (#i < #t03))"
/*
guarded formula characterizing all counter-examples:
"∃ user server t unbl commitment solution bt tokenIssuer Y secr_key
   #t01 #t02 #t03.
  (Setup_Ti( tokenIssuer, Y, secr_key ) @ #t01) ∧
  (UsrCreateToken( user, server, tokenIssuer, solution, bt, t
   ) @ #t02) ∧
  (UsrVerifyAndStoreToken( user, server, t, unbl, commitment
   ) @ #t03)
 ∧
  (#t01 < #t02) ∧
  (#t02 < #t03) ∧
  (∀ #i.
    (TiSignsToken( tokenIssuer, t, secr_key ) @ #i)
   ⇒
    ((¬(#t02 < #i)) ∨ (¬(#i < #t03))))"
*/
by sorry

lemma one_more_token_security:
  all-traces
  "∀ tokenIssuer server user t Y secr_key res #i #k #l.
    (((((Setup_Ti( tokenIssuer, Y, secr_key ) @ #i) ∧
        (TiVerifySignedToken( tokenIssuer, t, secr_key ) @ #k)) ∧
       (SrvSendNewResource( server, user, res, t ) @ #l)) ∧
      (#i < #k)) ∧
     (#k < #l)) ⇒
    (∃ #j.
      (TiSignsToken( tokenIssuer, t, secr_key ) @ #j) ∧ (#j < #k))"
/*
guarded formula characterizing all counter-examples:
"∃ tokenIssuer server user t Y secr_key res #i #k #l.
  (Setup_Ti( tokenIssuer, Y, secr_key ) @ #i) ∧
  (TiVerifySignedToken( tokenIssuer, t, secr_key ) @ #k) ∧
  (SrvSendNewResource( server, user, res, t ) @ #l)
 ∧
  (#i < #k) ∧
  (#k < #l) ∧
  (∀ #j.
    (TiSignsToken( tokenIssuer, t, secr_key ) @ #j) ⇒ ¬(#j < #k))"
*/
simplify
solve( !State_Ti_signedBlTok( ~chId_srv_ti, $Ti, $Srv, ~n.2,
                              signedBlTok, signedBlTok1, signedBlTok2
       ) ▶₁ #k )
  case Ti_verify_solution
  solve( State_Srv_forward_stored_token( MAC(h2(t,
                                                sign(signedToken, srv_secr_key)),
                                             CalcR($Usr.1, $Srv.1, request.1)),
                                         t, srv_secr_key, ~chId_srv_ti.1, ~chId_srv_usr, $Srv.1,
                                         $Ti.1, request.1
         ) ▶₂ #l )
    case Srv_forward_stored_token
    solve( In_S( ~chId_srv_ti, $Ti, $Srv,
                 <'4', $Ti, URL(url.1), SignedToken(signedBlTok), 
                  SignedToken(signedBlTok1), SignedToken(signedBlTok2), CHash(c), 
                  SMod(s.1), CHash(c1), SMod(s1), CHash(c2), SMod(s2)>
           ) ▶₀ #vr.5 )
      case ChanIn_S_case_1
      solve( In_S( ~chId_srv_ti, $Srv, $Ti,
                   <'8', $Usr, URL(request), Token(t), 
                    SMAC(MAC(h2(t, sign(h1(t), ~n.2)), CalcR($Usr, $Ti, request)))>
             ) ▶₀ #k )
        case ChanIn_S_case_1
